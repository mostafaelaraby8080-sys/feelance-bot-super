# --- تيليجرام (إلزامي) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# --- المنصات ---
# nafezly,mostaql,khamsat
PLATFORMS=nafezly,mostaql,khamsat
CHECK_INTERVAL_MINUTES=5
MAX_JOBS_PER_PLATFORM=5
NAFEZLY_CHANNEL=https://t.me/s/Nafezly

# --- قاعدة البيانات ---
DATABASE_PATH=jobs.db

# --- الشبكة ---
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=3

# --- توليد العرض (اختياري: من غيره بيستخدم قالب جاهز) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- إرسال العرض على الموقع ---
# http: على API جاهز | playwright: متصفح حقيقي
SUBMIT_BACKEND=playwright
# SUBMIT_API_URL=https://example.com/api/apply
# SUBMIT_API_TOKEN=...
SUBMIT_HEADLESS=1
